# ============================================================
# TRACE-X — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to source control.
# All values below are safe DEMO defaults only.
# ============================================================

# ── Application ─────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=tracex
POSTGRES_PASSWORD=tracexpass
POSTGRES_DB=tracex
# Full connection URL (auto-assembled by Docker Compose; override here for local dev)
# POSTGRES_URL=postgresql+asyncpg://tracex:tracexpass@localhost:5432/tracex

# ── Neo4j ───────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tracexneo4j

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Kafka / Redpanda ────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TRANSACTION_TOPIC=tracex.transactions
KAFKA_DLQ_TOPIC=tracex.dlq
# Set to true to bypass Kafka and ingest directly (dev/demo mode)
DIRECT_INGEST_MODE=true

# ── AI Provider ─────────────────────────────────────────────
# Leave empty to use deterministic fallback (no API key needed for demo)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Security ────────────────────────────────────────────────
# Change this before any real deployment
JWT_SECRET_KEY=tracex-demo-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── Detection Thresholds (demo values — not legal thresholds) ─
STRUCTURING_THRESHOLD=10000
RAPID_PASSTHROUGH_SECONDS=300
BURST_WINDOW_SECONDS=3600
BURST_COUNT_THRESHOLD=10
DORMANCY_THRESHOLD_DAYS=90
CIRCULAR_FLOW_MAX_DEPTH=4
REVENUE_MISMATCH_RATIO=5.0
ROUND_AMOUNT_THRESHOLD=10000
MAX_GRAPH_TRAVERSAL_DEPTH=4

# ── Risk Fusion Weights ──────────────────────────────────────
RISK_WEIGHT_RULE=0.30
RISK_WEIGHT_ANOMALY=0.25
RISK_WEIGHT_GRAPH=0.25
RISK_WEIGHT_TEMPORAL=0.20

# ── Risk Thresholds ──────────────────────────────────────────
RISK_LOW_MAX=29
RISK_MEDIUM_MAX=59
RISK_HIGH_MAX=79
# 80-100 = Critical

# ── Upload Limits ────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_ROWS=100000

# ── Demo Seed ────────────────────────────────────────────────
SYNTHETIC_SEED=42
SYNTHETIC_NORMAL_COUNT=500
SYNTHETIC_SUSPICIOUS_COUNT=50
